[Unit]
Description=profile backend (Tornado)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/profile
EnvironmentFile=-/home/profile/.env

ExecStart=/root/.local/bin/pipenv run python app.py
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
