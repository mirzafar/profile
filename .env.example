# Copy to .env and fill in. Never commit the real .env.

# Google OAuth (from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Admin bootstrap (used only on first run to create the admin)
ADMIN_LOGIN=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Server
# Keep COOKIE_SECRET fixed in production so sessions survive restarts
COOKIE_SECRET=
DEBUG=false
PORT=8888
